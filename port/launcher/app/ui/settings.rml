<rml>
<head>
    <title>OpenTricky settings</title>
    <link type="text/rcss" href="launcher.rcss"/>
    <link type="text/template" href="tpl_side.rml"/>
    <link type="text/template" href="tpl_topbar.rml"/>
    <link type="text/template" href="tpl_hints.rml"/>
</head>
<body data-model="ot" class="settings">
    <div class="bg">
        <img class="grad" src="ot:bg/$track$"/>
        <div class="carpet" data-if="have_art"><span data-for="c : carpet"><img data-attr-src="'ot:carpet/' + c"/></span></div>
        <div class="shade"></div>
    </div>

    <div class="stage" id="stage">

        <template src="topbar"/>

        <div class="title">Settings</div>
        <div class="presets">
            <span class="pl">Preset</span>
            <div class="seg"><span data-for="p : presets" data-class-on="it_index == preset" data-attr-id="'preset' + it_index" data-event-click="preset(it_index)"><span class="t">{{p}}</span><div class="u" data-if="it_index == preset"></div></span></div>
        </div>

        <!-- Tabs and rows are built from the settings registry (settings.h). -->
        <div class="stabs">
            <span class="stab" data-for="t : tabs" data-class-on="it_index == tab" data-attr-id="'tab' + it_index" data-event-click="set_tab(it_index)"><span class="t">{{t}}</span></span>
        </div>

        <div class="rows" id="rows">
            <div class="ininote" data-if="ini_note != ''">{{ini_note}}</div>
            <div data-for="r : rows"><div data-class-grp="r.is_group" data-class-row="!r.is_group" data-attr-rid="r.id"
                 data-attr-id="'r' + r.id" data-event-click="row_click(r.id)">
                <span data-if="r.is_group">{{r.label}}</span><div class="rule" data-if="r.is_group"></div>
                <span class="mod" data-if="r.changed"></span>
                <span class="lab" data-if="!r.is_group">{{r.label}}</span>
                <span class="val" data-if="r.arrows"><span class="left">&#x2039;</span>{{r.value}}<span class="right">&#x203A;</span></span>
                <span class="tog" data-if="r.toggle" data-class-on="r.on"><span class="knob"></span></span>
                <span class="plainv" data-if="r.plain">{{r.value}}</span>
                <span class="act" data-if="r.button != ''"><span class="av" data-if="r.value != ''">{{r.value}}</span><span class="ab" data-class-off="r.idle">{{r.button}}</span></span>
            </div><div class="rnote" data-if="r.note != ''"><span class="sq"></span>{{r.note}}</div></div>

            <!-- CONTROLS: the remapping table, one line per PS2 button. -->
            <div class="ctl" data-if="tab == 3">
                <div class="grp">MAPPING &#xB7; PS2 LAYOUT</div>
                <div class="chead"><span class="h1">PS2 BUTTON</span><span class="h2">KEYBOARD</span><span class="h3">CONTROLLER</span></div>
                <div data-for="c : ctls"><div class="crow">
                    <span class="cib"><img class="ci" data-attr-src="c.icon"/></span><span class="cl">{{c.label}}</span>
                    <span class="cell ck" data-class-chg="c.kchg" data-attr-rid="2000 + c.k * 2" data-attr-id="'k' + c.k"
                          data-event-click="ctl_click(c.k, 0)">{{c.key}}</span>
                    <span class="cell cp" data-if="c.has_pad" data-class-chg="c.pchg" data-attr-rid="2001 + c.k * 2" data-attr-id="'c' + c.k"
                          data-event-click="ctl_click(c.k, 1)">{{c.pad}}</span>
                </div></div>
            </div>
        </div>

        <div class="help">
            <!-- CONTROLS: the four button styles, each drawn with its own pictures. -->
            <div class="styles" data-if="tab == 3">
                <div class="st" data-class-on="bstyle == 0" data-event-click="style_pick(0)"><span class="sn">AUTO</span>
                    <span class="si"><img src="icons/jc/T_X_A_Color.png"/><img src="icons/jc/T_X_B_Color.png"/><img src="icons/jc/T_X_X_Color.png"/><img src="icons/jc/T_X_Y_Color.png"/></span></div>
                <div class="st" data-class-on="bstyle == 1" data-event-click="style_pick(1)"><span class="sn">XBOX MODERN</span>
                    <span class="si"><img src="icons/jc/T_X_A_Color.png"/><img src="icons/jc/T_X_B_Color.png"/><img src="icons/jc/T_X_X_Color.png"/><img src="icons/jc/T_X_Y_Color.png"/></span></div>
                <div class="st" data-class-on="bstyle == 2" data-event-click="style_pick(2)"><span class="sn">PLAYSTATION MODERN</span>
                    <span class="si"><img src="icons/jc/T_P4_Cross_Color_Retro.png"/><img src="icons/jc/T_P4_Circle_Color_Retro.png"/><img src="icons/jc/T_P4_Square_Color_Retro.png"/><img src="icons/jc/T_P4_Triangle_Color_Retro.png"/></span></div>
                <div class="st" data-class-on="bstyle == 3" data-event-click="style_pick(3)"><span class="sn">PS2 ORIGINAL</span>
                    <span class="si ps2"><img src="icons/ps2/ps2_cross.png"/><img src="icons/ps2/ps2_circle.png"/><img src="icons/ps2/ps2_square.png"/><img src="icons/ps2/ps2_triangle.png"/></span></div>
            </div>
            <!-- GRAPHICS / DISPLAY: a picture of the chosen value (verified disc only) -->
            <div class="prev" data-if="prev_src != ''">
                <img class="old" data-if="prev_old != ''" data-attr-src="prev_old"/>
                <img id="prevnew" data-attr-src="prev_src"/>
                <span class="tag">{{prev_label}}</span>
            </div>
            <h3>{{help_title}}</h3>
            <p>{{help_text}}</p>
            <p class="extra" data-if="help_extra != ''">{{help_extra}}</p>
        </div>

    </div>

    <!-- Sidebar and footer hold the window's edges; the stage is centred. -->
    <template src="side"/>

    <div class="foot sfoot">
        <div class="fin" id="fin">
            <div class="links"><span class="l rn" data-event-click="open('releases')">Release notes</span><span class="sep"></span><span class="l gh" data-event-click="open('github')">GitHub</span></div>
            <div class="btn reset" id="reset" data-event-click="reset_tab"><span>Reset tab</span></div>
            <div class="btn pri save" id="save" data-event-click="save"><span>Save</span></div>
            <div class="note">{{saved_note}}</div>
            <template src="hints"/>
        </div>
    </div>
</body>
</rml>
