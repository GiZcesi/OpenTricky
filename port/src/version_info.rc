/*
 * version_info.rc -- the VERSIONINFO resource of both executables (Explorer's
 * Properties > Details, crash tools). Included by each executable's .rc after
 * it defines:
 *   OT_FILE_DESCRIPTION  "SSX Tricky" or "OpenTricky launcher"
 *   OT_ORIGINAL_FILENAME "SSX Tricky.exe" or "OpenTricky.exe"
 * The numbers come from version.h.
 */
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     OT_VERSION_MAJOR, OT_VERSION_MINOR, OT_VERSION_PATCH, 0
PRODUCTVERSION  OT_VERSION_MAJOR, OT_VERSION_MINOR, OT_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      OT_PRODUCT_NAME
            VALUE "FileDescription",  OT_FILE_DESCRIPTION
            VALUE "FileVersion",      OT_VERSION
            VALUE "InternalName",     OT_ORIGINAL_FILENAME
            VALUE "LegalCopyright",   OT_COPYRIGHT
            VALUE "OriginalFilename", OT_ORIGINAL_FILENAME
            VALUE "ProductName",      OT_PRODUCT_NAME
            VALUE "ProductVersion",   OT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
